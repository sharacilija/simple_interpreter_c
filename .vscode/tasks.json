{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Interpreter",
            "type": "shell",
            "command": "C:/msys64/mingw64/bin/gcc.exe",
            "args": [
                "-Wall",
                "-Wextra",
                "-std=c17",
                "-g",
                "${workspaceFolder}/interpreter.c",
                "-o",
                "${workspaceFolder}/interpreter.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}